{
  "schema": 2,
  "area": "content",
  "scope": "Tests exercise the vector pipeline and the stable render API; behaviour was checked against ISO 32000-1 (Adobe PDF 1.7) and ISO 32000-2.",
  "requirements": [
    {
      "id": "content-vector-pipeline",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.4",
        "8.5"
      ],
      "status": "integrated stable render API",
      "tests": [
        "content/compound-path",
        "content/clip-after-paint",
        "content/stroke-nonuniform"
      ],
      "gaps": "text, images and general stroke adjustment remain incomplete"
    },
    {
      "id": "content-lexical-sequence",
      "reference": "adobe-pdf17",
      "clauses": [
        "7.8.2"
      ],
      "status": "implemented",
      "tests": [
        "content/compound-operands-split"
      ],
      "gaps": "inline images unsupported"
    },
    {
      "id": "content-explicit-operators",
      "reference": "adobe-pdf17",
      "clauses": [
        "Annex A"
      ],
      "status": "recognized and validated",
      "tests": [
        "content/compatibility",
        "content/text",
        "pagura-render/src/tests.rs"
      ],
      "gaps": "text, images, Type3, mesh shadings and tiling patterns unsupported"
    },
    {
      "id": "content-colour",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.6",
        "8.6.5.5",
        "10.4"
      ],
      "status": "device, ICC fallback, Indexed, CalGray/CalRGB/Lab, tint alternates",
      "tests": [
        "content/cmyk",
        "content/indexed",
        "content/icc-alternate",
        "content/default-space"
      ],
      "gaps": "ICC profile transforms and nondefault input ranges; nonzero CIE black points; special colourants"
    },
    {
      "id": "content-opaque-groups",
      "reference": "adobe-pdf17",
      "clauses": [
        "11.3",
        "11.4"
      ],
      "status": "opaque Normal RGB fast path; general composition covered by content-transparency",
      "tests": [
        "content/opaque-page-group",
        "content/opaque-form-group",
        "content/rgb-page-group",
        "content/rgb-form-group",
        "content/icc-rgb-group"
      ],
      "gaps": "calibrated blending spaces, subtractive overprint and transfer-region selection"
    },
    {
      "id": "content-page-transform",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.3.2"
      ],
      "status": "implemented",
      "tests": [
        "content/rotate-90",
        "content/rotate-180",
        "content/rotate-270",
        "content/crop",
        "content/user-unit"
      ],
      "gaps": ""
    },
    {
      "id": "content-fractional",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.5.3"
      ],
      "status": "exact rectangle pixel overlaps",
      "tests": [
        "content/fractional",
        "content/fractional-clip",
        "content/fractional-clip-intersection",
        "content/decimal-stroke-half-tie"
      ],
      "gaps": ""
    },
    {
      "id": "content-forms",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.10"
      ],
      "status": "implemented",
      "tests": [
        "content/form",
        "content/form-resources"
      ],
      "gaps": "image XObjects unsupported"
    },
    {
      "id": "content-optional",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.11"
      ],
      "status": "default configuration, membership expressions and View usage applications",
      "tests": [
        "content/optional-default",
        "content/optional-AnyOn",
        "content/optional-AllOn",
        "content/optional-AnyOff",
        "content/optional-AllOff",
        "content/optional-expression"
      ],
      "gaps": "viewer-specific user/language context"
    },
    {
      "id": "content-cie",
      "reference": "iso32000-2-full-text",
      "clauses": [
        "8.6.5.2",
        "8.6.5.3",
        "8.6.5.4"
      ],
      "status": "CalGray, CalRGB and Lab; Bradford white adaptation to D65, sRGB output",
      "tests": [
        "content/cie-CalGray",
        "content/cie-CalGray-gamma",
        "content/cie-Lab",
        "content/cie-indexed-Lab",
        "content/cie-CalRGB",
        "content/cie-CalRGB-matrix"
      ],
      "gaps": "nonzero BlackPoint unsupported"
    },
    {
      "id": "content-functions",
      "reference": "adobe-pdf17",
      "clauses": [
        "7.10.2",
        "7.10.3",
        "7.10.4",
        "7.10.5",
        "8.6.6.4",
        "8.6.6.5"
      ],
      "status": "sampled, exponential, stitching, calculator; tint alternates and transfer functions",
      "tests": [
        "content/function-exp-1",
        "content/function-exp-2",
        "content/function-stitch",
        "content/function-sampled",
        "content/function-calculator",
        "content/transfer-type2",
        "content/transfer-type4",
        "content/function-order3-small",
        "content/function-truncated",
        "content/function-cycle",
        "content/function-dimension",
        "content/function-undefined",
        "content/function-host-action",
        "content/function-order3",
        "content/transfer-array"
      ],
      "gaps": "sampled cubic interpolation with size >=4; special None/All colourants; transfer-region selection under transparency"
    },
    {
      "id": "content-usage",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.11.4.4",
        "8.11.4.5"
      ],
      "status": "View applications; View/Print/Export recommendations, initial Zoom=1; AND across AS entries",
      "tests": [
        "content/usage-View",
        "content/usage-Print-ignored",
        "content/usage-no-OCGs",
        "content/usage-Zoom-on",
        "content/usage-Zoom-off",
        "content/usage-conjunction"
      ],
      "gaps": "user/language/creator-specific categories require explicit viewer context"
    },
    {
      "id": "content-annotations",
      "reference": "iso32000-2-full-text",
      "clauses": [
        "12.5.2",
        "12.5.3",
        "12.5.5"
      ],
      "status": "normal appearance streams, screen visibility and state selection",
      "tests": [
        "content/annotation",
        "content/annotation-rotated",
        "content/annotation-state",
        "content/annotation-sheared",
        "content/annotation-state-isolation",
        "content/annotation-link-borderless"
      ],
      "gaps": "NoZoom/NoRotate; generation of absent appearances"
    },
    {
      "id": "content-halftone",
      "reference": "iso32000-2-full-text",
      "clauses": [
        "10.6.1"
      ],
      "status": "continuous-tone RGB bypass",
      "tests": [
        "content/halftone-continuous"
      ],
      "gaps": ""
    },
    {
      "id": "content-transparency",
      "reference": "iso32000-2-full-text",
      "clauses": [
        "11.3.3",
        "11.3.5",
        "11.4",
        "11.6.6",
        "11.7.4.4"
      ],
      "status": "constant opacity, standard blend modes, isolated/non-isolated and knockout groups, Gray/RGB/CMYK",
      "tests": [
        "content/blend-Multiply",
        "content/blend-Hue",
        "content/group-i0-k1",
        "content/group-colour-DeviceCMYK",
        "content/alpha-combined",
        "content/group-alpha-shape-0",
        "content/group-alpha-shape-1",
        "content/blend-isolated-page",
        "content/alpha-accumulation",
        "content/group-incoming-alpha"
      ],
      "gaps": "calibrated group blending; subtractive overprint; transfer-region selection"
    },
    {
      "id": "content-soft-masks",
      "reference": "iso32000-2-full-text",
      "clauses": [
        "11.5.2",
        "11.5.3",
        "11.6.5.1"
      ],
      "status": "Alpha/Luminosity, BC and TR with frozen source CTM",
      "tests": [
        "content/soft-Alpha",
        "content/soft-Luminosity-transfer",
        "content/soft-crop-once",
        "content/soft-frozen-transform"
      ],
      "gaps": ""
    },
    {
      "id": "content-shadings",
      "reference": "iso32000-2-full-text",
      "clauses": [
        "8.7.2",
        "8.7.4.1",
        "8.7.4.2",
        "8.7.4.5.2",
        "8.7.4.5.3",
        "8.7.4.5.4"
      ],
      "status": "function, axial and radial shadings; shading patterns; global device-centre sampling and optional box filtering",
      "tests": [
        "content/shading-axial",
        "content/shading-cone",
        "content/shading-function",
        "content/pattern-anchored",
        "content/pattern-background"
      ],
      "gaps": "mesh shadings, tiling patterns, pattern ExtGState; degenerate BBox scan conversion"
    }
  ]
}
