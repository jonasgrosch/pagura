{
  "schema": 2,
  "area": "content",
  "scope": "Tests exercise the additive compile_page API. ISO 32000-2 locators not verified against the unavailable full text.",
  "requirements": [
    {
      "id": "content-vector-pipeline",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.4",
        "8.5"
      ],
      "status": "implemented through compile_page",
      "tests": [
        "content/compound-path",
        "content/clip-after-paint",
        "content/stroke-nonuniform"
      ],
      "gaps": ""
    },
    {
      "id": "content-lexical-sequence",
      "reference": "adobe-pdf17",
      "clauses": [
        "7.8.2"
      ],
      "status": "implemented",
      "tests": [
        "content/compound-operands-split"
      ],
      "gaps": "inline images unsupported"
    },
    {
      "id": "content-explicit-operators",
      "reference": "adobe-pdf17",
      "clauses": [
        "Annex A"
      ],
      "status": "recognized and validated",
      "tests": [
        "content/compatibility",
        "content/text",
        "pagura-render/src/tests.rs"
      ],
      "gaps": "text, images, Type3 and shadings unsupported"
    },
    {
      "id": "content-colour",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.6",
        "8.6.5.5",
        "10.4"
