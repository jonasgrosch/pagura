      ],
      "status": "opaque Normal non-knockout groups",
      "tests": [
        "content/opaque-page-group",
        "content/opaque-form-group"
      ],
      "gaps": "explicit group colour spaces and nontrivial transparency unsupported"
    },
    {
      "id": "content-page-transform",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.3.2"
      ],
      "status": "implemented",
      "tests": [
        "content/rotate-90",
        "content/rotate-180",
        "content/rotate-270",
        "content/crop",
        "content/user-unit"
      ],
      "gaps": ""
