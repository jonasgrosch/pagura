{
  "schema": 2,
  "area": "raster",
  "scope": "Independently derived geometry; ISO 32000-2 locators not verified against the unavailable full text.",
  "requirements": [
    {
      "id": "raster-exact-area",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.5.3.3"
      ],
      "status": "signed cell-area and cover sweep; exact crossing-block integration",
      "tests": [
        "raster/triangle",
        "raster/concave",
        "raster/self-intersection",
        "raster/overlap-nonzero",
        "raster/overlap-evenodd",
        "raster/crossing-set-0",
        "raster/crossing-set-1",
        "raster/crossing-set-2",
        "raster/crossing-set-3",
        "raster/crossing-set-4",
        "raster/crossing-set-5",
        "raster/crossing-set-6",
        "raster/crossing-set-7",
        "raster/crossing-set-8",
        "raster/crossing-set-9",
        "raster/crossing-set-10",
        "raster/crossing-set-11",
        "raster/crossing-set-12",
        "raster/crossing-set-13",
        "raster/crossing-set-14",
        "raster/crossing-set-15"
      ],
      "gaps": "crossing-block/partial-row fallback remains superlinear in worst case; caller raster_work bounds it"
    },
    {
      "id": "raster-curves",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.5.2.2"
      ],
      "status": "adaptive device-space flattening at 1/256 pixel",
      "tests": [
        "raster/cubic"
      ],
      "gaps": "subdivision limits reject extreme curves"
    },
    {
      "id": "raster-strokes",
      "reference": "adobe-pdf17",
      "clauses": [
        "8.4.3.2",
        "8.4.3.3",
        "8.4.3.4",
        "8.4.3.5",
        "8.4.3.6"
      ],
      "status": "implemented",
      "tests": [
        "raster/cap-butt",
        "raster/cap-round",
        "raster/cap-square",
        "raster/round-dot",
        "pagura-raster/src/tests.rs",
        "raster/join-miter",
        "raster/join-bevel",
        "raster/join-round",
        "raster/miter-limit",
        "raster/dash-odd-phase",
        "raster/closed-dash-seam",
        "raster/zero-on-dash",
        "raster/square-dot"
      ],
      "gaps": "Broader curve-stroke offset, curved-dash and extreme-coordinate independent vectors remain"
    },
    {
      "id": "raster-stroke-adjustment",
      "reference": "adobe-pdf17",
      "clauses": [
        "10.6.5"
      ],
      "status": "orthogonal grid fitting with user-space dashes and rounded device pen diameters",
      "tests": [
        "content/stroke-adjust-horizontal",
        "content/stroke-adjust-vertical"
      ],
      "gaps": "curved/oblique fitting explicitly unsupported"
    }
  ]
}
