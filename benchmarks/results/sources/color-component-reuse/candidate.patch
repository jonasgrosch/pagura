+//! Device shorthand must preserve default-space lookup and graphics state.
+use super::*;
+use crate::color::Space;
+use pagura_core::syntax::{Origin, Parser};
+use pagura_core::{Limits, ObjectId, Position};
+use pagura_document::{Document, OpenOptions};
+
+fn document() -> Document {
+    Document::open(
+        pagura_testkit::fixture("classic", "blank.pdf"),
+        &OpenOptions::default(),
+    )
+    .unwrap()
+}
+
+fn resources(bytes: &[u8]) -> Dictionary {
+    let value = Parser::new(bytes, Origin::Buffer, Limits::default())
+        .parse()
+        .unwrap();
+    let Value::Dictionary(dictionary) = value else {
+        panic!("expected resource dictionary");
+    };
+    dictionary
+}
+
+fn components(color: &Color) -> &[f64] {
+    let Color::Solid { components, .. } = color else {
+        panic!("expected solid color");
+    };
+    components
+}
+
+#[test]
+fn device_shorthand_resolves_default_rgb_and_restores_saved_colors() {
+    let document = document();
+    let mut compiler = Compiler::new(&document, document.page(0).unwrap()).unwrap();
+    let resources = resources(
+        b"<< /ColorSpace << /DefaultRGB [/CalRGB << /WhitePoint [1 1 1] /Gamma [2 2 2] >>] >> >>",
+    );
+    compiler
+        .sequence_bytes(
+            b"0.2 0.4 0.6 rg q 1 0 0 rg Q 0.1 0.3 0.5 RG",
+            &[],
+            &resources,
+        )
+        .unwrap();
+    assert!(matches!(
+        compiler.state.fill,
+        Color::Solid {
+            space: Space::Cie(_),
+            ..
+        }
+    ));
+    assert!(matches!(
+        compiler.state.stroke_color,
+        Color::Solid {
+            space: Space::Cie(_),
+            ..
+        }
+    ));
+    assert_eq!(components(&compiler.state.fill), &[0.2, 0.4, 0.6]);
+    assert_eq!(components(&compiler.state.stroke_color), &[0.1, 0.3, 0.5]);
+    assert_eq!(document.diagnostics(), [] as [pagura_core::Diagnostic; 0]);
+}
+
+#[test]
+fn invalid_default_space_is_reported_before_component_update() {
+    let document = document();
+    let mut compiler = Compiler::new(&document, document.page(0).unwrap()).unwrap();
+    compiler
+        .color(b"g", &[Value::Real(0.75)], &Dictionary::new())
+        .unwrap();
+    let resources = resources(b"<< /ColorSpace << /DefaultRGB /DeviceGray >> >>");
+    assert_eq!(
+        compiler
+            .color(
+                b"rg",
+                &[Value::Integer(1), Value::Integer(0), Value::Integer(0)],
+                &resources
+            )
+            .unwrap_err(),
+        Error::syntax("default colour space has wrong component count"),
+    );
+    assert!(matches!(
+        compiler.state.fill,
+        Color::Solid {
+            space: Space::Gray,
+            ..
+        }
+    ));
+    assert_eq!(components(&compiler.state.fill), &[0.75]);
+}
+
+#[test]
+fn shorthand_component_error_preserves_selected_default_and_source_context() {
+    let document = document();
+    let mut compiler = Compiler::new(&document, document.page(0).unwrap()).unwrap();
+    compiler
+        .color(b"g", &[Value::Real(0.75)], &Dictionary::new())
+        .unwrap();
+    // Directly exercise the existing color-selection order: a successful
+    // space selection precedes its component validation.
+    assert_eq!(
+        compiler
+            .color(
+                b"rg",
+                &[Value::Integer(1), Value::Null, Value::Integer(0)],
+                &Dictionary::new()
+            )
+            .unwrap_err(),
+        Error::syntax("colour component must be a number"),
+    );
+    assert!(matches!(
+        compiler.state.fill,
+        Color::Solid {
+            space: Space::Rgb,
+            ..
+        }
+    ));
+    assert_eq!(components(&compiler.state.fill), &[0.0; 3]);
+
+    // Numeric sc operands pass operator validation, but the wrong arity
+    // reaches Color::set through the real interpreter without losing origin.
+    let object = ObjectId::new(17, 0);
+    let error = compiler
+        .sequence_bytes(b"1 0 sc", &[(0, object)], &Dictionary::new())
+        .unwrap_err();
+    assert_eq!(error.kind, pagura_core::ErrorKind::Syntax);
+    assert_eq!(error.message, "wrong colour component count");
+    assert_eq!(error.position, Position::Stream { object, offset: 4 });
+    assert_eq!(error.object, Some(object));
+    assert_eq!(components(&compiler.state.fill), &[0.0; 3]);
+}
