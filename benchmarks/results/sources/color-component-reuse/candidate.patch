+++ b/crates/pagura-render/src/color_set_tests.rs
@@ -0,0 +1,106 @@
+//! Updating components must retain validation and state semantics.
+use super::*;
+
+fn components(color: &Color) -> &Vec<f64> {
+    let Color::Solid { components, .. } = color else {
+        panic!("expected a solid color");
+    };
+    components
+}
+
+#[test]
+fn set_reuses_storage_without_changing_default_values() {
+    for (space, defaults) in [
+        (Space::Gray, vec![0.0]),
+        (Space::Rgb, vec![0.0; 3]),
+        (Space::Cmyk, vec![0.0, 0.0, 0.0, 1.0]),
+        (
+            Space::Special {
+                inputs: 6,
+                all: false,
+            },
+            vec![1.0; 6],
+        ),
+    ] {
+        let mut color = Color::new(space);
+        assert_eq!(components(&color), &defaults);
+        let pointer = components(&color).as_ptr();
+        let capacity = components(&color).capacity();
+        let values = vec![Value::Real(0.25); defaults.len()];
+        color.set(&values).unwrap();
+        assert_eq!(components(&color), &vec![0.25; defaults.len()]);
+        assert_eq!(components(&color).as_ptr(), pointer);
+        assert_eq!(components(&color).capacity(), capacity);
+        color.set(&vec![Value::Integer(1); defaults.len()]).unwrap();
+        assert_eq!(components(&color), &vec![1.0; defaults.len()]);
+        assert_eq!(components(&color).as_ptr(), pointer);
+    }
+}
+
+#[test]
+fn invalid_late_values_preserve_all_components_and_storage() {
+    for invalid in [
+        Value::Null,
+        Value::Real(f64::NAN),
+        Value::Real(f64::INFINITY),
+    ] {
+        let mut color = Color::new(Space::Rgb);
+        color
+            .set(&[Value::Real(0.2), Value::Real(0.4), Value::Real(0.6)])
+            .unwrap();
+        let pointer = components(&color).as_ptr();
+        let capacity = components(&color).capacity();
+        assert_eq!(
+            color
+                .set(&[Value::Integer(1), Value::Integer(0), invalid])
+                .unwrap_err(),
+            Error::syntax("colour component must be a number"),
+        );
+        assert_eq!(components(&color), &[0.2, 0.4, 0.6]);
+        assert_eq!(components(&color).as_ptr(), pointer);
+        assert_eq!(components(&color).capacity(), capacity);
+    }
+}
+
+#[test]
+fn pattern_and_arity_errors_keep_their_precedence() {
+    let mut color = Color::new(Space::Cmyk);
+    assert_eq!(
+        color.set(&[Value::Null]).unwrap_err(),
+        Error::syntax("wrong colour component count")
+    );
+    assert_eq!(components(&color), &[0.0, 0.0, 0.0, 1.0]);
+    let mut pattern = Color::new(Space::Pattern(None));
+    assert_eq!(
+        pattern.set(&[Value::Null]).unwrap_err(),
+        Error::syntax("pattern requires SCN or scn")
+    );
+    assert!(matches!(
+        pattern,
+        Color::Pattern {
+            base: None,
+            selected: None
+        }
+    ));
+}
+
+#[test]
+fn numeric_values_remain_unclamped_and_clones_stay_independent() {
+    let mut color = Color::new(Space::Rgb);
+    let saved = color.clone();
+    color
+        .set(&[
+            Value::Real(-0.0),
+            Value::Real(-2.0),
+            Value::Integer(i64::MAX),
+        ])
+        .unwrap();
+    let actual = components(&color);
+    assert_eq!(actual[0].to_bits(), (-0.0_f64).to_bits());
+    assert_eq!(actual[1], -2.0);
+    assert_eq!(
+        actual[2].to_bits(),
+        Value::Integer(i64::MAX).as_number().unwrap().to_bits()
+    );
+    assert_eq!(components(&saved), &[0.0; 3]);
+}
