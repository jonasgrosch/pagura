+#[test]
+fn f32_output_preserves_offsets_complete_pixels_and_destination_tails() {
+    let buffer = Buffer::F32(vec![
+        [99.0; 4],
+        [f32::from_bits(0x3eff_ffff), 0.5, 1.5, 254.5],
+        [f32::NEG_INFINITY, f32::INFINITY, f32::from_bits(0x7f80_0001), 255.0],
+    ]);
+    // Expected bytes follow the listed rational values and saturating casts;
+    // neither this oracle nor the boundary tests call the old byte helper.
+    let expected = [0, 1, 2, 255, 0, 255, 0, 255];
+    for count in 0..=13 {
+        let mut actual = vec![77; count];
+        buffer.output(1, &mut actual);
+        let written = (count / 4 * 4).min(expected.len());
+        assert_eq!(&actual[..written], &expected[..written], "length {count}");
+        assert!(actual[written..].iter().all(|&value| value == 77));
+
+        // A valid offset exactly at the source end writes nothing, even into
+        // a destination with several complete pixels and a partial tail.
+        let mut untouched = vec![77; count];
+        buffer.output(3, &mut untouched);
+        assert_eq!(untouched, vec![77; count]);
+    }
+}
