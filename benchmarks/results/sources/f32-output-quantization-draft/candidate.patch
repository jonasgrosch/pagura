+#[test]
+fn f32_output_half_transitions_match_independent_integer_expectations() {
+    for n in 1..=u8::MAX {
+        // (2*n - 1)/2 is exactly representable. Its adjacent positive f32
+        // values lie strictly on opposite sides of that rational threshold.
+        let half = f32::from(n) - 0.5;
+        let previous = f32::from_bits(half.to_bits() - 1);
+        let next = f32::from_bits(half.to_bits() + 1);
+        let buffer = Buffer::F32(vec![[previous, half, next, f32::from(n)]]);
+        let mut actual = [77; 4];
+        buffer.output(0, &mut actual);
+        assert_eq!(actual, [n - 1, n, n, n], "transition {n}");
+    }
+}
