@@ -0,0 +1,62 @@
+//! Capacity preparation must not change construction state or path geometry.
+use super::*;
+
+#[test]
+fn reserve_preserves_an_open_subpath_and_its_closing_point() {
+    let mut path = PathBuilder::new();
+    path.move_to(Point::new(2.0, 3.0));
+    path.line_to(Point::new(4.0, 5.0)).unwrap();
+    path.reserve(5);
+    let pointer = path.segments.as_ptr();
+    assert_eq!(path.len(), 2);
+    assert_eq!(path.current_point(), Some(Point::new(4.0, 5.0)));
+    path.cubic_to(
+        Point::new(6.0, 7.0),
+        Point::new(8.0, 9.0),
+        Point::new(10.0, 11.0),
+    )
+    .unwrap();
+    path.close();
+    assert_eq!(path.current_point(), Some(Point::new(2.0, 3.0)));
+    assert_eq!(path.segments.as_ptr(), pointer);
+    assert_eq!(
+        path.finish().segments(),
+        &[
+            Segment::MoveTo(Point::new(2.0, 3.0)),
+            Segment::LineTo(Point::new(4.0, 5.0)),
+            Segment::CubicTo(
+                Point::new(6.0, 7.0),
+                Point::new(8.0, 9.0),
+                Point::new(10.0, 11.0),
+            ),
+            Segment::Close,
+        ],
+    );
+    assert!(path.is_empty());
+    assert_eq!(path.current_point(), None);
+    assert!(path.line_to(Point::new(1.0, 1.0)).is_none());
+}
+
+#[test]
+fn rectangle_preserves_negative_and_degenerate_geometry_after_a_prefix() {
+    let mut path = PathBuilder::new();
+    path.move_to(Point::new(20.0, 30.0));
+    path.rect(4.0, 5.0, -2.0, 0.0);
+    assert_eq!(path.current_point(), Some(Point::new(4.0, 5.0)));
+    path.line_to(Point::new(7.0, 8.0)).unwrap();
+    path.close();
+    assert_eq!(path.current_point(), Some(Point::new(4.0, 5.0)));
+    assert_eq!(
+        path.finish().segments(),
+        &[
+            Segment::MoveTo(Point::new(20.0, 30.0)),
+            Segment::MoveTo(Point::new(4.0, 5.0)),
+            Segment::LineTo(Point::new(2.0, 5.0)),
+            Segment::LineTo(Point::new(2.0, 5.0)),
+            Segment::LineTo(Point::new(4.0, 5.0)),
+            Segment::Close,
+            Segment::LineTo(Point::new(7.0, 8.0)),
+            Segment::Close,
+        ],
+    );
+}
diff --git a/crates/pagura-render/src/interpreter/path_reserve_tests.rs b/crates/pagura-render/src/interpreter/path_reserve_tests.rs
