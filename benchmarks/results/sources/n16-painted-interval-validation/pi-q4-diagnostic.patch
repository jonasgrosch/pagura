+    fn temporary_n16_resource_boundary_probe() {
+        let tile = Tile { x: 0, y: 0, width: 3, height: 2 };
+        let background = pagura_raster::Rgba8::opaque(17, 85, 170);
+        for (label, pixels, decoded_bytes, raster_work, message, counters) in [
+            ("fit", 6, 55, 17, None, (17, 55, 13)),
+            ("pixel-below", 5, 55, 17, Some("page pixel budget exceeded"), (11, 7, 13)),
+            ("bytes-below", 6, 54, 17, Some("colour buffer memory exceeded"), (11, 7, 13)),
+            ("work-below", 6, 55, 16, Some("compositing work budget exceeded"), (11, 55, 13)),
+        ] {
+            let mut context = glyph_context(Limits {
+                pixels, decoded_bytes, raster_work, ..Limits::default()
+            });
+            // Synthetic prior ledger use; this is not allocator/RSS evidence.
+            context.work = 11;
+            context.allocated = 7;
+            context.function_work = 13;
+            let result = context.page_surface(tile, plan::Format::N16, [17, 85, 170, 255], false);
+            let observed = result.as_ref().map(|page| page.narrow().unwrap().bytes())
+                .map_err(Error::clone);
+            let expected = message.map_or(Ok(48), |message| Err(Error::limit(message)));
+            assert_eq!(observed, expected, "{label}");
+            assert_eq!((context.work, context.allocated, context.function_work), counters, "{label}");
+            println!("PAGURA_PI_Q4_V1 page={label} result={observed:?} counters={counters:?}");
+            if let Ok(mut page) = result {
+                let mut output = Pixmap::new(3, 2, background, 6).unwrap();
+                for painted in [false, true] {
+                    if painted {
+                        page.narrow_mut().unwrap().path(5, &[255], [0.0; 4], 1.0).unwrap();
+                    }
+                    context.write_output(&page, &[], Model::Rgb, &mut output, tile).unwrap();
+                    let mut expected = [17_u8, 85, 170, 255].repeat(6);
+                    if painted {
+                        expected[20..24].copy_from_slice(&[0, 0, 0, 255]);
+                    }
+                    assert_eq!(output.data(), expected);
+                    assert_eq!((context.work, context.allocated, context.function_work), counters);
+                    println!("PAGURA_PI_Q4_V1 output painted={painted} counters={counters:?} pixels={:?}", output.data());
+                }
+            }
+        }
+    }
 
