+    let actual = values.capacity().saturating_mul(size_of::<T>());
+    let reserved = (*held - planned).saturating_add(actual);
+    if reserved > budget {
+        *values = Vec::new();
+        return Err(Error::limit("glyph row fragment budget exceeded"));
+    }
